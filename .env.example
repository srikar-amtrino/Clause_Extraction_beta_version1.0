# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=
LOG_LEVEL=INFO

# Google OAuth client used to sign in and read Drive files
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/google-drive/oauth/callback/

# Google Picker (folder selection UI in the ingestion connector)
GOOGLE_PICKER_API_KEY=your-picker-api-key
GOOGLE_PICKER_APP_ID=your-google-cloud-project-number

# Neon Postgres. Without it the app falls back to local SQLite.
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Upstash Redis used by Celery. Use the Redis REST hostname and token from Upstash.
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Parsing
PARSE_MAX_FILE_BYTES=52428800

# Persistence (Step 2.3). Defaults are fine for development.
# Keep the parser's verbatim output alongside the extracted rows.
PARSE_STORE_RAW_RESULT=true
# Leave blank to use the build named in settings/base.py, which moves with
# every parser behaviour change so unchanged files are re-extracted.
PARSER_BUILD=
PERSIST_BULK_BATCH_SIZE=500

# Chunking. Defaults are fine for development.
# Bump when the chunking rules change, so already-chunked parses are redone
# instead of being treated as current.
CHUNKER_VERSION=
CHUNK_BULK_BATCH_SIZE=500

# Classification on AWS Bedrock. Check a new environment with
# `python manage.py check_bedrock` before classifying anything.
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-west-1
# invoke = Bedrock InvokeModel; mantle = the Messages API endpoint newer models
# need, which has no endpoint in us-west-1.
BEDROCK_CLIENT=invoke
# A Bedrock model id or inference-profile ARN. Required.
CLASSIFY_MODEL_ID=arn:aws:bedrock:us-west-1:ACCOUNT_ID:inference-profile/global.anthropic.claude-sonnet-4-6
CLASSIFY_TAXONOMY_VERSION=v1
# Blank = model defaults. CLASSIFY_THINKING=adaptive turns thinking on.
CLASSIFY_THINKING=
CLASSIFY_EFFORT=
# Review routing: below this confidence, or in these taxonomy keys, goes to review.
CLASSIFY_CONFIDENCE_THRESHOLD=0.85
CLASSIFY_HIGH_RISK_TYPES=indemnification,limitation-of-liability,intellectual-property
# Batching and retries. Defaults are fine for development.
CLASSIFY_MAX_BATCH_TOKENS=6000
CLASSIFY_MAX_ITEMS_PER_BATCH=20
CLASSIFY_CONCURRENCY=4
CLASSIFY_ITEM_ATTEMPTS=3
CLASSIFY_SDK_MAX_RETRIES=4
CLASSIFY_MAX_TOKENS=16000
CLASSIFY_BULK_BATCH_SIZE=500
