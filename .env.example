# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=
LOG_LEVEL=INFO

# Google OAuth client used to read Drive files
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Development only: refresh token written by `python manage.py drive_authorize`
GOOGLE_DRIVE_TOKEN_PATH=.secrets/drive_token.json

# Parsing
PARSE_MAX_FILE_BYTES=52428800
